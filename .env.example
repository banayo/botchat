# ==============================
# LLM (vLLM OpenAI-compatible)
# ==============================
OPENAI_API_KEY=not-needed
OPENAI_API_BASE_URL=http://vllm:8000/v1
LLM_MODEL_NAME=your-vllm-model-name
ENABLE_OLLAMA_API=false

ENABLE_SIGNUP=false
# ต้องคงที่ทุกครั้งที่ recreate container ไม่เช่นนั้น OAuth session/token ใช้ไม่ได้
WEBUI_SECRET_KEY=เปลี่ยนเป็นสุ่มยาวคงที่
# WEBUI_PORT=3000 production Not use

# ==============================
# Database Settings (PostgreSQL)
# ==============================
POSTGRES_USER=admin
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=enterprise_ai
POSTGRES_PORT=5432
# Open WebUI primary DB + RAG (host ใช้ชื่อ service ใน Docker = db)
VECTOR_DB=pgvector
DATABASE_URL=postgresql://admin:your-postgres-password@db:5432/enterprise_ai
PGVECTOR_DB_URL=postgresql://admin:your-postgres-password@db:5432/enterprise_ai
WEBUI_URL=https://chat.example.com
# ==============================
# Open WebUI: Web Search & Tools
# ==============================
CHAT_RESPONSE_MAX_TOOL_CALL_ITERATIONS=8
ENABLE_WEB_SEARCH=true
WEB_SEARCH_ENGINE=searxng
SEARXNG_QUERY_URL=http://searxng:8080/search?q=<query>
SEARXNG_SECRET=เปลี่ยนเป็นสุ่มยาวคงที่
WEB_SEARCH_RESULT_COUNT=3
WEB_SEARCH_CONCURRENT_REQUESTS=2
WEB_LOADER_CONCURRENT_REQUESTS=2
WEB_LOADER_ENGINE=safe_web
WEB_LOADER_TIMEOUT=15
WEB_FETCH_MAX_CONTENT_LENGTH=16000
ENABLE_WEB_SEARCH_CONFIRMATION=true

# ใช้เมื่อรัน API นอก Docker (ใน docker-compose จะ override เป็น db)
DB_HOST=db

# ==============================
# Sales Database (External PostgreSQL)
# ==============================
SALES_DB_HOST=your-sales-db-host
SALES_DB_NAME=posbk
SALES_DB_USER=your-sales-db-user
SALES_DB_PASSWORD=your-sales-db-password
SALES_DB_PORT=5432


# Shared Oracle listener (host/service). Users are per department.
ORACLE_HOST=192.168.x.x
ORACLE_PORT=1521
ORACLE_SERVICE=ชื่อเซอร์วิสหรือSID

# Export: SELECT on export view only.
EXPORT_ORACLE_USER=EXPORT_AI
EXPORT_ORACLE_PASSWORD=รหัสผ่าน
# fallback if EXPORT_ORACLE_* empty
ORACLE_USER=EXPORT_AI
ORACLE_PASSWORD=รหัสผ่าน

# Marketing: SELECT on marketing view only.
MKT_ORACLE_USER=MKT_AI
MKT_ORACLE_PASSWORD=รหัสผ่าน

# ==============================
# Authentik SSO (API only)
# ==============================
AUTHENTIK_ISSUER=https://authentik.example.com/application/o/your-app/
AUTHENTIK_JWKS_URL=https://authentik.example.com/application/o/your-app/jwks/
# หรือให้ API อนุมาน JWKS จาก OPENID_PROVIDER_URL ได้ถ้า AUTHENTIK_JWKS_URL ว่าง
OPENID_PROVIDER_URL=https://authentik.example.com/application/o/your-app/.well-known/openid-configuration
OAUTH_CLIENT_ID=your-oauth-client-id
OAUTH_CLIENT_SECRET=your-oauth-client-secret
OAUTH_PROVIDER_NAME=Authentik
OPENID_REDIRECT_URI=https://chat.example.com/oauth/oidc/callback
ENABLE_OAUTH_SIGNUP=true
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true
# ต้องมี offline_access เพื่อรีเฟรช token ให้ tools (__oauth_token__)
OAUTH_SCOPES=openid email profile offline_access
AUTHENTIK_GROUP_CLAIM=groups
ENABLE_LOGIN_FORM=false
ENABLE_PASSWORD_AUTH=false
# Comma-separated Authentik groups allowed to use export APIs. Empty = any valid JWT.
EXPORT_ALLOWED_GROUPS=
MKT_ALLOWED_GROUPS=
MKT_VIEW_OWNER=KMPROD
MKT_VIEW_NAME=MKT$ERP_SALE_REP

